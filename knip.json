{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-for-unpinned-dependencies.mjs",
        "scripts/check-agent-skills-in-sync.mjs"
      ],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/agent-tool": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/backend": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/frontend": {
      "entry": [
        "src/**/*.test.ts",
        "*.test.ts",
        "wdio.shared.conf.ts",
        "wdio.headless.conf.ts",
        "e2e/specs/**/*.spec.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "*.ts"]
    },
    "packages/shared-types": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@types/mocha",
    "@wdio/dot-reporter",
    "@wdio/local-runner",
    "@wdio/spec-reporter"
  ]
}
