{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "wdio.shared.conf.ts",
    "wdio.headless.conf.ts",
    "e2e/specs/**/*.spec.ts",
    "packages/agent-tool/test/**/*.test.ts",
    "worker/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "worker/**/*.ts",
    "e2e/**/*.ts",
    "packages/agent-tool/**/*.ts",
    "*.ts"
  ],
  "ignoreDependencies": [
    "@types/mocha",
    "@wdio/dot-reporter",
    "@wdio/local-runner",
    "@wdio/spec-reporter",
    "depcheck"
  ]
}
