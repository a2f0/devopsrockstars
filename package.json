{
  "name": "devopsrockstars",
  "version": "2.0.68",
  "private": true,
  "license": "UNLICENSED",
  "description": "",
  "engines": {
    "bun": ">=1.4.2 <1.5"
  },
  "type": "module",
  "scripts": {
    "start-server": "bun run --filter @devopsrockstars/frontend start",
    "start-test-server": "bun run --filter @devopsrockstars/frontend start:test",
    "test": "bun run --filter @devopsrockstars/frontend test",
    "test-headless": "bun run --filter @devopsrockstars/frontend test:headless",
    "ci": "bun scripts/testing/ci.ts",
    "ci-headless": "bun scripts/testing/ci.ts --headless",
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "flags": "bun scripts/dev/feature-flags.ts",
    "flags:check": "bun scripts/dev/feature-flags.ts --check",
    "skyline:update": "bun scripts/dev/skyline.ts",
    "skyline:check": "bun scripts/dev/skyline.ts --check",
    "checkout:ascii": "bun packages/frontend/tooling/checkoutAscii.ts",
    "format": "bun run --bun biome format --write",
    "build": "bun run --filter @devopsrockstars/frontend build",
    "dev:cloudflare": "bun run --filter @devopsrockstars/backend dev",
    "db:migrate:local": "bun run --filter @devopsrockstars/backend db:migrate:local",
    "lint": "bun run --bun biome lint --fix",
    "lint:md": "bun run --bun markdownlint-cli2",
    "compile": "bun run --bun tsc --noEmit",
    "unit": "bun test --timeout 60000 packages/diagnostics/src packages/backend/src packages/frontend/src packages/frontend/buildAssets.test.ts packages/frontend/tooling scripts",
    "deploy:staging": "bun scripts/deploy/deploy.ts staging",
    "deploy:prod": "bun scripts/deploy/deploy.ts prod",
    "db:check:staging": "bun run --filter @devopsrockstars/backend db:check:staging",
    "db:check:prod": "bun run --filter @devopsrockstars/backend db:check:prod",
    "start-staging-server": "bun run --filter @devopsrockstars/frontend start:staging",
    "version:patch": "bun scripts/release/version-bump.ts",
    "check:unused": "bun run --bun knip",
    "agents:sync": "bun run agent-tool skills install --apply",
    "agents:check": "bun run agent-tool skills check",
    "lint:branch-name": "agent-tool branch check",
    "check": "agent-tool run-group scripts/testing/check.json"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.20",
    "@biomejs/biome": "2.6.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.42.1",
    "markdownlint-cli2": "0.24.0",
    "typescript": "7.0.2",
    "wrangler": "4.151.2",
    "@sentry/cli": "3.8.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [],
  "patchedDependencies": {
    "expect@30.5.2": "patches/expect@30.5.2.patch",
    "markdownlint@0.42.0": "patches/markdownlint@0.42.0.patch",
    "miniflare@5.20261019.0-beta": "patches/miniflare@5.20261019.0-beta.patch"
  }
}
