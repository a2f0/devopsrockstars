{
  "name": "devopsrockstars",
  "version": "2.0.68",
  "private": true,
  "description": "",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "type": "module",
  "scripts": {
    "start-server": "pnpm --filter @devopsrockstars/frontend start",
    "start-test-server": "pnpm --filter @devopsrockstars/frontend start:test",
    "test": "pnpm --filter @devopsrockstars/frontend test",
    "test-headless": "pnpm --filter @devopsrockstars/frontend test:headless",
    "ci": "start-server-and-test start-test-server http-get://localhost:8081 \"start-staging-server\" http-get://localhost:8082 test",
    "ci-headless": "start-server-and-test start-test-server http-get://localhost:8081 \"start-staging-server\" http-get://localhost:8082 test-headless",
    "agent-tool": "tsx packages/agent-tool/src/index.ts",
    "agent-tool:test": "tsx --test packages/agent-tool/test/*.test.ts",
    "format": "biome format --write",
    "build": "pnpm --filter @devopsrockstars/frontend build",
    "dev:cloudflare": "pnpm --filter @devopsrockstars/backend dev",
    "db:migrate:local": "pnpm --filter @devopsrockstars/backend db:migrate:local",
    "depcheck": "depcheck && pnpm --recursive exec depcheck",
    "lint": "biome lint --fix",
    "lint:md": "markdownlint-cli2",
    "compile": "tsc",
    "unit": "tsx --test 'packages/backend/src/**/*.test.ts' 'packages/frontend/src/**/*.test.ts' 'packages/frontend/*.test.ts' 'packages/agent-tool/test/*.test.ts'",
    "prepare": "pnpm run compile",
    "pretest": "pnpm run compile",
    "posttest": "pnpm run lint",
    "deploy:staging": "scripts/deploy.sh staging",
    "deploy:prod": "scripts/deploy.sh prod",
    "db:migrate:staging": "pnpm --filter @devopsrockstars/backend db:migrate:staging",
    "db:migrate:prod": "pnpm --filter @devopsrockstars/backend db:migrate:prod",
    "start-staging-server": "pnpm --filter @devopsrockstars/frontend start:staging"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tsconfig/strictest": "2.0.8",
    "@types/leaflet": "1.9.22",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wdio/cli": "9.32.0",
    "@wdio/dot-reporter": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "copy-webpack-plugin": "14.0.0",
    "depcheck": "1.4.7",
    "html-webpack-plugin": "5.6.8",
    "knip": "6.39.0",
    "markdownlint-cli2": "0.23.3",
    "start-server-and-test": "3.0.12",
    "ts-loader": "9.6.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "url-loader": "4.1.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0",
    "wrangler": "4.147.0"
  }
}
