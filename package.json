{
  "name": "devopsrockstars-frontend",
  "version": "2.0.65",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "type": "module",
  "scripts": {
    "start-server": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' webpack serve --mode development --history-api-fallback",
    "start-test-server": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' webpack serve --port 8081 --mode development --history-api-fallback",
    "test": "NODE_OPTIONS='--experimental-specifier-resolution=node' npx wdio wdio.shared.conf.ts",
    "test-headless": "NODE_OPTIONS='--experimental-specifier-resolution=node' npx wdio wdio.headless.conf.ts",
    "ci": "start-server-and-test start-test-server http-get://localhost:8081 test",
    "ci-headless": "start-server-and-test start-test-server http-get://localhost:8081 test-headless",
    "format": "biome format --write",
    "build": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' webpack --mode production",
    "lint": "biome lint --fix",
    "compile": "tsc",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@a2f0/check-for-unpinned-dependencies": "1.0.4",
    "@biomejs/biome": "1.9.4",
    "@tsconfig/strictest": "2.0.5",
    "@types/leaflet": "1.9.19",
    "@types/mocha": "10.0.10",
    "@types/node": "24.1.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/react-router-dom": "5.3.3",
    "@types/styled-components": "5.1.34",
    "@wdio/cli": "9.16.2",
    "@wdio/dot-reporter": "9.18.0",
    "@wdio/globals": "9.17.0",
    "@wdio/local-runner": "9.18.4",
    "@wdio/mocha-framework": "9.16.2",
    "@wdio/spec-reporter": "9.18.0",
    "copy-webpack-plugin": "13.0.0",
    "html-webpack-plugin": "5.6.3",
    "start-server-and-test": "2.0.12",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "url-loader": "4.1.1",
    "webpack": "5.101.0",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  },
  "dependencies": {
    "@svgr/webpack": "8.1.0",
    "leaflet": "1.9.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.6.3",
    "react-svg": "16.3.0",
    "styled-components": "6.1.19"
  }
