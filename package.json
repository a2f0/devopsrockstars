{
  "name": "devopsrockstars-frontend",
  "version": "2.0.68",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "type": "module",
  "scripts": {
    "start-server": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' webpack serve --mode development --history-api-fallback",
    "start-test-server": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' webpack serve --port 8081 --mode development --history-api-fallback",
    "test": "NODE_OPTIONS='--experimental-specifier-resolution=node' npx wdio wdio.shared.conf.ts",
    "test-headless": "NODE_OPTIONS='--experimental-specifier-resolution=node' npx wdio wdio.headless.conf.ts",
    "ci": "start-server-and-test start-test-server http-get://localhost:8081 test",
    "ci-headless": "start-server-and-test start-test-server http-get://localhost:8081 test-headless",
    "format": "biome format --write",
    "build": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' webpack --mode production",
    "lint": "biome lint --fix",
    "compile": "tsc",
    "prepare": "pnpm run compile",
    "pretest": "pnpm run compile",
    "posttest": "pnpm run lint"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@a2f0/check-for-unpinned-dependencies": "github:a2f0/check-for-unpinned-dependencies#chore-package-maintenance",
    "@biomejs/biome": "2.3.14",
    "@tsconfig/strictest": "2.0.8",
    "@types/leaflet": "1.9.21",
    "@types/mocha": "10.0.10",
    "@types/node": "25.2.2",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@types/react-router-dom": "5.3.3",
    "@types/styled-components": "5.1.36",
    "@wdio/cli": "9.23.3",
    "@wdio/dot-reporter": "9.23.3",
    "@wdio/globals": "9.23.0",
    "@wdio/local-runner": "9.23.3",
    "@wdio/mocha-framework": "9.23.3",
    "@wdio/spec-reporter": "9.23.3",
    "copy-webpack-plugin": "13.0.1",
    "html-webpack-plugin": "5.6.6",
    "start-server-and-test": "2.1.3",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "url-loader": "4.1.1",
    "webpack": "5.105.0",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.3"
  },
  "dependencies": {
    "@svgr/webpack": "8.1.0",
    "leaflet": "1.9.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.13.0",
    "react-svg": "16.4.1",
    "styled-components": "6.3.8"
  }
