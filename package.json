{
  "name": "devopsrockstars-frontend",
  "version": "2.0.68",
  "description": "",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "type": "module",
  "scripts": {
    "start-server": "NODE_OPTIONS='--import tsx' webpack serve --mode development --history-api-fallback",
    "start-test-server": "NODE_OPTIONS='--import tsx' webpack serve --port 8081 --mode development --history-api-fallback",
    "test": "NODE_OPTIONS='--experimental-specifier-resolution=node' npx wdio wdio.shared.conf.ts",
    "test-headless": "NODE_OPTIONS='--experimental-specifier-resolution=node' npx wdio wdio.headless.conf.ts",
    "ci": "start-server-and-test start-test-server http-get://localhost:8081 test",
    "ci-headless": "start-server-and-test start-test-server http-get://localhost:8081 test-headless",
    "format": "biome format --write",
    "build": "NODE_OPTIONS='--import tsx' webpack --mode production",
    "lint": "biome lint --fix",
    "compile": "tsc",
    "prepare": "pnpm run compile",
    "pretest": "pnpm run compile",
    "posttest": "pnpm run lint"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@a2f0/check-for-unpinned-dependencies": "github:a2f0/check-for-unpinned-dependencies#chore-package-maintenance",
    "@biomejs/biome": "2.5.7",
    "@tsconfig/strictest": "2.0.8",
    "@types/leaflet": "1.9.22",
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wdio/cli": "9.30.1",
    "@wdio/dot-reporter": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "copy-webpack-plugin": "14.0.0",
    "depcheck": "1.4.7",
    "html-webpack-plugin": "5.6.8",
    "knip": "6.32.0",
    "markdownlint-cli2": "0.23.2",
    "start-server-and-test": "3.0.12",
    "ts-loader": "9.6.2",
    "tsx": "4.23.9",
    "typescript": "6.0.3",
    "url-loader": "4.1.1",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "6.0.0"
  },
  "dependencies": {
    "@svgr/webpack": "8.1.0",
    "leaflet": "1.9.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "react-router": "8.3.0",
    "react-svg": "19.1.1",
    "styled-components": "6.5.0"
  }
}
