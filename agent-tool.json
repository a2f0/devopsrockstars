{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 72
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "code-quality",
        "workflow": "Github Actions"
      }
    ],
    "requireStrictBaseFreshness": true
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "branch": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "exempt": ["main", "staging"],
    "maxLength": null
  }
}
