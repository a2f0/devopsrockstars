{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 72
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "code-quality",
        "workflow": "Github Actions"
      }
    ],
    "requireStrictBaseFreshness": true
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "images": {
    "targets": {
      "favicons": {
        "outputs": [
          {
            "path": "favicon.svg",
            "layers": [{ "source": "logo" }]
          },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "layers": [{ "source": "logo" }]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              { "fill": "#000000" },
              { "source": "logo", "scale": 0.8 }
            ]
          }
        ]
      },
      "social": {
        "outputs": [
          {
            "path": "og-image.png",
            "size": [1200, 630],
            "opaque": true,
            "layers": [
              { "fill": "#000000" },
              { "source": "logo", "scale": 0.6 }
            ]
          }
        ]
      }
    }
  },
  "branch": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "exempt": ["main", "staging"],
    "maxLength": null
  }
}
