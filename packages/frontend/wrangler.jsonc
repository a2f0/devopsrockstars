{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-31",
  // Every route has its own document from the build, so other paths get
  // 404.html with a real 404 status instead of the home page.
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // Always deploy with an explicit --env; there is no unnamed Worker. Only the
  // Terraform-managed custom domains serve these, so neither the staging site
  // nor a preview ever appears on a second, indexable hostname.
  "env": {
    "staging": {
      "name": "devopsrockstars-website-staging",
      "workers_dev": false,
      "preview_urls": false
    },
    "prod": {
      "name": "devopsrockstars-website-prod",
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
