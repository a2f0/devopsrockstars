{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devopsrockstars-store",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devopsrockstars-store",
      "database_id": "3c4ece27-9b96-4978-b747-77a9fa67b7e2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
