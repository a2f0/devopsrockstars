{
  "$schema": "https://biomejs.dev/schemas/2.3.4/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noUnusedImports": "off"
      },
      "a11y": {
        "useValidAriaRole": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "bracketSpacing": false,
      "arrowParentheses": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.ts-out/**/*",
      "!**/build/**/*",
      "!**/*.d.ts",
      "!**/src/ts-out/**/*",
      "!**/dev-dist/",
      "!**/dist/",
      "!**/node_modules/"
    ]
  }
}
